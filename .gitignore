# Dependencies
node_modules/

# Build output. Only the files package.json's exports point at are committed, so
# installs straight from Git work even when the package manager skips the build
# (bun does). Everything else here is regenerated by `npm run release`.
dist/*
!dist/smiles-drawer.min.js
!dist/smiles-drawer.min.mjs
!dist/types/

# Tooling caches
coverage/
.eslintcache
*.tsbuildinfo

# Python (RDKit reference generators in test/*-reference)
__pycache__/
*.pyc
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log

# Secrets
.env
.env.*

# Agent / assistant files
CLAUDE.md
AGENTS.md
.claude/

# Personal scratch space (debug scripts, experiments)
practice/
test/local/

# Temp planning docs
TODO.md
TODO.docx
ROADMAP.md
STEREO_FIX_HANDOFF.md
